{
  "name": "@infinithoughts/backend",
  "version": "0.0.1",
  "description": "Backend API for infinithoughts platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrations/run.ts",
    "seed": "tsx src/scripts/seed-articles.ts",
    "verify": "tsx src/scripts/verify-articles.ts",
    "import-samples": "tsx scripts/import-sample-articles.ts",
    "test:db": "tsx scripts/test-db-connection.ts",
    "test:api": "bash scripts/test-api.sh",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.10.0",
    "redis": "^4.6.10",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.22.4",
    "xml2js": "^0.6.2",
    "js2xmlparser": "^5.0.0",
    "axios": "^1.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/pg": "^8.10.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.4",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.11",
    "typescript": "^5.2.2",
    "tsx": "^4.1.0",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4"
  }
}
