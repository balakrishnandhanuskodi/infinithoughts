# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (for frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (backend only - NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase URL for functions
SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# Firebase Cloud Messaging (for push notifications)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@infinithoughts.com

# Authentication
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
APPLE_OAUTH_CLIENT_ID=your-apple-client-id

# Application Settings
APP_URL=http://localhost:3000
APP_ENV=development
NODE_ENV=development
